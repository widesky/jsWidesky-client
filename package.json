{
  "name": "@widesky/jswidesky-client",
  "version": "3.6.0",
  "description": "WideSky Client in JavaScript",
  "main": "index.js",
  "browser": "index.browser.js",
  "unpkg": "index.browser.js",
  "private": false,
  "scripts": {
    "test": "JUNIT_REPORT_PATH=report.xml npx mocha --colors --reporter mocha-jenkins-reporter $(find test -name \"*.js\")",
    "coverage": "npx nyc --reporter=html --reporter=text mocha test/*/**.js",
    "build": "npm run build:node && npm run build:browser && npm run build:types",
    "build:node": "webpack --config webpack.node.config.js",
    "build:browser": "webpack --config webpack.browser.config.js",
    "build:types": "tsc --project tsconfig.types.json && rollup -c rollup.config.mjs && rimraf types"
  },
  "author": "WideSky.cloud <support@widesky.com>",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "axios": "1.20.0",
    "axios-http2-adapter": "^1.0.3",
    "bunyan": "^1.8.15",
    "bunyan-format": "^0.2.1",
    "cli-progress": "^3.12.0",
    "http2-wrapper": "2.2.1",
    "jsesc": "^3.0.2",
    "lodash": "^4.17.21",
    "moment-timezone": "^0.5.38",
    "process": "^0.11.10",
    "socket.io-client": "^2.4.0",
    "stream-browserify": "^3.0.0",
    "url-parse": "^1.5.10",
    "util": "^0.12.5",
    "uuid": "^9.0.1",
    "yup": "^1.3.2"
  },
  "devDependencies": {
    "chai": "^4.3.6",
    "copy-webpack-plugin": "^13.0.0",
    "mocha": "^10.1.0",
    "mocha-jenkins-reporter": "^0.4.8",
    "nyc": "^15.1.0",
    "proxyquire": "^2.1.3",
    "rollup": "^4.41.1",
    "rollup-plugin-dts": "^6.2.1",
    "sinon": "^14.0.1",
    "terser-webpack-plugin": "^5.3.10",
    "typescript": "^5.8.3",
    "webpack": "^5.76.0",
    "webpack-cli": "^4.10.0"
  }
}
